# Copy to server/.env  (never commit .env)
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=replace_with_64_hex_chars          # openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_chars      # openssl rand -hex 32
CLIENT_ORIGIN=http://localhost:5173

# AI (free tier, Google AI Studio key, no billing). Verify current model IDs in AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_BALANCED=
GEMINI_MODEL_REASONING=
GEMINI_MODEL_VISION=
AI_MODE=cached                                # live | cached | mock
AI_BUDGET_MODE=FREE_ONLY
AI_MAX_RETRIES=2
AI_RPM_LIMIT=5                                # conservative local throttle - set below the published free limit
AI_RPD_LIMIT=100

DEMO_MODE=true
LOG_LEVEL=info
